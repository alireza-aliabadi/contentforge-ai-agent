# Application
APP_NAME=ContentForge AI Agent
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+psycopg://contentforge:contentforge@localhost:5432/contentforge

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object storage (MinIO / S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=contentforge-assets
S3_REGION=us-east-1
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./data/uploads

# External AI APIs (no local models)
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
IMAGE_GEN_API_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=dall-e-3
USE_MOCK_AI=true

# Evaluation thresholds
ORIGINALITY_THRESHOLD=0.90
RELEVANCE_THRESHOLD=0.90
MAX_REGENERATION_LOOPS=3

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=contentforge-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_ADMIN_EMAIL=admin@contentforge.local
DEFAULT_ADMIN_PASSWORD=changeme

# Rate limiting
RATE_LIMIT=100/minute
